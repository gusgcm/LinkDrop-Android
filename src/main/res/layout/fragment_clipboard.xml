<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLIPBOARD SYNC"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetDeviceClip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📱 From Phone"
            android:textColor="@color/text_main"
            android:backgroundTint="@color/bg_card"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetPcClip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="💻 From PC"
            android:textColor="@color/text_main"
            android:backgroundTint="@color/bg_card"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <!-- Text area -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="12dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/border">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/clipText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Clipboard content…"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_dim"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:background="@color/bg_card" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendToPC"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="⬆ Send to PC"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/accent"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPushToPhone"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📋 Copy Here"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/accent2"
            app:cornerRadius="8dp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
